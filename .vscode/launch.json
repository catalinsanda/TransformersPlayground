    "version": "0.2.0",
    "configurations": [
        {
            "name": "Generate Tokens",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/generate.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Train Transformer Simple Exmple",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train_fox.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            }
        },
        {
            "name": "Train Transformer Tiny Shakespeare",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/train_shakespeare.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "PYTHONUNBUFFERED": "1"
            }
        }
    ]
}